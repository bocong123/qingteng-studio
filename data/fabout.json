  "idea1": {
    "kicker": "教学理念",
    "title": "一套理念，贯穿所有课程",
    "titleEm": "贯穿所有课程",
    "sub": "青藤画室的教学理念不是口号，而是每一天上课时的具体选择：怎么教观察、怎么讲造型、怎么对待孩子画出的“不标准”。",
    "items": [
      {
        "num": "01 以苏派为体",
        "title": "严谨的造型基础",
        "desc": "苏派指学院派严谨的造型训练体系。素描、速写、色彩三科遵循统一的造型逻辑，基本功扎实、经得起考试检验，是“体”。"
      },
      {
        "num": "02 以青藤为魂",
        "title": "自由生长的精神",
        "desc": "青藤代表自由生长的艺术精神。保护孩子的想象力与个性表达，让画面里有“人”、有“感受”，是“魂”。"
      },
      {
        "num": "03 承古韵之精微",
        "title": "承古韵之精微",
        "desc": "从经典与大师作品中学习观察的深度与表达的克制，让孩子在传统中汲取养分，而不是被传统捆住。"
      },
      {
        "num": "04 养今我之性灵",
        "title": "养今我之性灵",
        "desc": "最终回到“今天的孩子”本身：他的眼睛、他的感受、他的表达。师古而不泥古，学的是方法，长的是自己。"
      }
    ],
    "quote": "以苏派为体，以青藤为魂。承古韵之精微，养今我之性灵。师古而不泥古。",
    "quoteSub": "—— 青藤画室教学理念 · 不止于应试，更受益于审美和思维"
  },
  "idea2": {
    "kicker": "为什么创办",
    "title": "为什么创办青藤画室",
    "titleEm": "青藤画室",
    "items": [
      {
        "num": "01",
        "title": "保护孩子的想象力和观察力",
        "desc": "见过太多孩子被“画得像”的标准吓住了手。青藤画室要做的第一件事，是让孩子敢画、会看——想象力与观察力才是绘画的源头。"
      },
      {
        "num": "02",
        "title": "拒绝机械临摹",
        "desc": "套路化训练能出短期成绩，却消耗长期兴趣与判断力。我们教孩子理解造型规律，用观察和思考画画，而不是背几张画去碰运气。"
      },
      {
        "num": "03",
        "title": "不止于应试",
        "desc": "中高考美术要成绩，但成绩不是终点。审美能力、思考能力与表达能力，才是孩子真正带得走、一辈子受用的东西。"
      },
      {
        "num": "04",
        "title": "更受益于审美与思维",
        "desc": "AI时代，工具会画画，稀缺的是审美判断与创造性思维。美术教育培养的正是这些能力——这也是青藤画室存在的意义。"
      }
    ]
  },
