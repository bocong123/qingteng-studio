{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qingteng-studio",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",

  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

"kv_namespaces": [
  {
    "binding": "LEADS",
    "id": "ccef3b33c79043999767358c634a5db5"
  },
  {
    "binding": "QT_ADMIN",
    "id": "308c2a0618ac40569570476997266ee3"
  }
],
"observability": {
  "logs": {
    "enabled": true,
    "head_sampling_rate": 1,
    "invocation_logs": true,
    "persist": true
  },
  "traces": {
    "enabled": false,
    "head_sampling_rate": 1,
    "persist": true
  }
}
